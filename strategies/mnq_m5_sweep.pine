// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
// MNQ NY-Open Liquidity Sweep (M5)
// Rules (same as backtest/sweep_backtest.py):
//  1. Levels: previous RTH day high/low, overnight (18:00-09:30) high/low,
//     Asia (20:00-00:00) and London (02:00-05:00) high/low, plus confirmed
//     swing highs/lows from 08:00 on. A level is used up once price trades through it.
//  2. 09:30-11:00 ET: a bar trades through an untouched level  -> sweep.
//  3. Within N bars a close back beyond the level and beyond the sweep bar's
//     opposite extreme confirms the rejection (optional: FVG required).
//  4. Entry market on the confirmation close (or limit at OTE retracement).
//     Stop 2 ticks beyond the sweep extreme.
//  5. Protection: TP1 at 1R closes 50 %, stop of the rest moves to breakeven,
//     TP2 at 2R. Everything flat at 11:30 ET.
//  6. Trend filter (default): long only if EMA20 > EMA50 on the chart timeframe, short only below.
//  7. ORB module (backtest/orb_backtest.py): first close beyond the 09:30-09:35 range, stop at the
//     range midpoint, same exits and trend filter. First signal of the day wins, one position at a time.
strategy("MNQ NY-Open Sweep + ORB", shorttitle = "MNQ Sweep+ORB", overlay = true,
     initial_capital = 25000, default_qty_type = strategy.fixed, default_qty_value = 2,
     margin_long = 0, margin_short = 0,   // no margin check: with the v6 default (100 %) 2 MNQ need ~$120k and every order is rejected
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
     slippage = 1, process_orders_on_close = true, calc_on_every_tick = false,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ───────── Inputs ─────────
const string TZ = "America/New_York"
grpS = "Session (New York time)"
iStart     = input.int(930,  "First entry (hhmm)",   group = grpS)
iLastEntry = input.int(1100, "Last entry (hhmm)",    group = grpS)
iFlat      = input.int(1130, "Flat at (hhmm)",       group = grpS)
iMaxTrades = input.int(2,    "Max trades per day",   minval = 1, group = grpS)
iMaxLosses = input.int(2,    "Stop after N losses",  minval = 1, group = grpS)

grpL = "Liquidity levels"
iUsePD     = input.bool(true, "Previous day RTH high/low", group = grpL)
iUseON     = input.bool(true, "Overnight high/low",        group = grpL)
iUseAsia   = input.bool(true, "Asia high/low",             group = grpL)
iUseLondon = input.bool(true, "London high/low",           group = grpL)
iUseSwing  = input.bool(true, "Intraday swings from 08:00", group = grpL)
iPivot     = input.int(2, "Swing strength (bars each side)", minval = 1, group = grpL)
iShowLv    = input.bool(true, "Draw levels (solid end = broken, dotted end = expired)", group = grpL)
iShowNames = input.bool(true, "Level names", group = grpL)

grpV = "Display"
iShowBoxes = input.bool(true, "Trade boxes (red = risk, green = target)", group = grpV)
iShowZ15   = input.bool(true, "M15 support/resistance zones (display only)", group = grpV)
iZ15Pivot  = input.int(3, "M15 zone swing strength", minval = 1, group = grpV)
iZ15Max    = input.int(30, "Max active M15 zones", minval = 1, group = grpV)

grpE = "Setup & entry"
iConfirm   = input.int(3, "Bars to confirm after sweep", minval = 0, group = grpE)
iStructLb  = input.int(0, "Structure lookback (0 = sweep bar itself)", minval = 0, group = grpE)
iCloseBack = input.bool(false, "Sweep bar must close back inside", group = grpE)
iNeedFvg   = input.bool(false, "Require FVG in displacement", group = grpE)
iEntryMode = input.string("Market", "Entry", options = ["Market", "OTE limit"], group = grpE)
iOte       = input.float(0.5, "OTE retracement", minval = 0.1, maxval = 0.95, step = 0.05, group = grpE)
iPendBars  = input.int(6, "Limit order lifetime (bars)", minval = 1, group = grpE)

grpT = "Trend filter"
iTrend = input.string("EMA 20/50", "Direction filter", options = ["None", "EMA 20/50", "Price vs VWAP", "Price vs H1 EMA50"], group = grpT)

grpO = "Opening range breakout"
iUseOrb = input.bool(true, "Trade ORB", group = grpO)
iOrbMin = input.int(5, "Opening range (minutes after 09:30)", minval = 1, group = grpO)

grpR = "Risk & protection"
iMinRisk = input.float(10.0,  "Min stop (points)", group = grpR)
iMaxRisk = input.float(150.0, "Max stop (points) - skip if larger", group = grpR)
iRiskAtr = input.float(5.0, "Sweep: max stop in ATR(14) (0 = use points)", minval = 0, step = 0.5, group = grpR)
iTp1R    = input.float(1.0, "TP1 (R)", step = 0.25, group = grpR)
iTp2R    = input.float(2.0, "TP2 (R)", step = 0.25, group = grpR)
iTp1Pct  = input.int(50, "TP1 size (%)", minval = 1, maxval = 99, group = grpR)
iBe      = input.bool(true, "Move stop to breakeven after TP1", group = grpR)

// ───────── Time helpers ─────────
hhmm(t) => hour(t, TZ) * 100 + minute(t, TZ)
tod     = hhmm(time)
todPrev = hhmm(time[1])
// true on the first bar at/after hhmm x (also across midnight / weekend gaps)
crossed(x) => tod >= x and (todPrev < x or tod < todPrev)
tick = syminfo.mintick

// ───────── Filters (all known at bar close) ─────────
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
atr14  = ta.atr(14)
vwapV  = ta.vwap(hlc3, crossed(930))
emaH1  = request.security(syminfo.tickerid, "60", ta.ema(close, 50)[1], lookahead = barmerge.lookahead_on)
trendOk(int s) =>
    switch iTrend
        "EMA 20/50"         => (ema20 - ema50) * s > 0
        "Price vs VWAP"     => (close - vwapV) * s > 0
        "Price vs H1 EMA50" => (close - emaH1) * s > 0
        => true

// ───────── Level store ─────────
var float[]  lvPx   = array.new_float()
var int[]    lvSide = array.new_int()     // +1 = high (sell-side sweep target), -1 = low
var string[] lvName = array.new_string()
var line[]   lvLine = array.new_line()

// a level is drawn from the bar where it formed until it is traded through (broken)
// or until the trading day ends (expired, dotted)
addLevel(float px, int side, string name, int x1) =>
    if not na(px)
        array.push(lvPx, px)
        array.push(lvSide, side)
        array.push(lvName, name)
        col = side > 0 ? color.new(color.red, 30) : color.new(color.teal, 30)
        array.push(lvLine, iShowLv ? line.new(x1, px, bar_index, px, extend = extend.right, color = col, width = 1) : na)
        if iShowLv and iShowNames
            label.new(x1, px, name, color = color(na), textcolor = col, size = size.tiny,
                 style = side > 0 ? label.style_label_lower_left : label.style_label_upper_left)

removeLevel(int k, bool broken) =>
    ln = array.get(lvLine, k)
    if not na(ln)
        line.set_extend(ln, extend.none)
        line.set_x2(ln, bar_index)
        if not broken
            line.set_style(ln, line.style_dotted)
    array.remove(lvPx, k)
    array.remove(lvSide, k)
    array.remove(lvName, k)
    array.remove(lvLine, k)

clearLevels() =>
    while array.size(lvPx) > 0
        removeLevel(array.size(lvPx) - 1, false)

// ───────── Session ranges ─────────
var float rthHi = na
var float rthLo = na
var float onHi = na
var float onLo = na
var float asHi = na
var float asLo = na
var float ldHi = na
var float ldLo = na
var int rthHiX = na
var int rthLoX = na
var int onHiX = na
var int onLoX = na
var int asHiX = na
var int asLoX = na
var int ldHiX = na
var int ldLoX = na

inRth    = tod >= 930 and tod < 1600
inOn     = tod >= 1800 or tod < 930
inAsia   = tod >= 2000
inLondon = tod >= 200 and tod < 500

// session ends -> publish levels (before any sweep check on this bar)
if crossed(1600) and not na(rthHi)
    clearLevels()                     // new trading day: drop yesterday's levels
    if iUsePD
        addLevel(rthHi, 1, "PDH", rthHiX)
        addLevel(rthLo, -1, "PDL", rthLoX)
    rthHi := na
    rthLo := na
if tod < 2000 and todPrev >= 2000 and not na(asHi)   // Asia ended at midnight
    if iUseAsia
        addLevel(asHi, 1, "Asia H", asHiX)
        addLevel(asLo, -1, "Asia L", asLoX)
    asHi := na
    asLo := na
if crossed(500) and not na(ldHi)
    if iUseLondon
        addLevel(ldHi, 1, "London H", ldHiX)
        addLevel(ldLo, -1, "London L", ldLoX)
    ldHi := na
    ldLo := na
if crossed(930) and not na(onHi)
    if iUseON
        addLevel(onHi, 1, "ON H", onHiX)
        addLevel(onLo, -1, "ON L", onLoX)
    onHi := na
    onLo := na

// accumulate ranges with the current bar
if crossed(1800)
    onHi := na
    onLo := na
if inRth
    if na(rthHi) or high > rthHi
        rthHi := high
        rthHiX := bar_index
    if na(rthLo) or low < rthLo
        rthLo := low
        rthLoX := bar_index
if inOn
    if na(onHi) or high > onHi
        onHi := high
        onHiX := bar_index
    if na(onLo) or low < onLo
        onLo := low
        onLoX := bar_index
if inAsia
    if na(asHi) or high > asHi
        asHi := high
        asHiX := bar_index
    if na(asLo) or low < asLo
        asLo := low
        asLoX := bar_index
if inLondon
    if na(ldHi) or high > ldHi
        ldHi := high
        ldHiX := bar_index
    if na(ldLo) or low < ldLo
        ldLo := low
        ldLoX := bar_index

// ───────── Intraday swings (confirmed iPivot bars later) ─────────
inSess = tod >= 800 and tod <= iFlat
if iUseSwing and inSess and bar_index > 2 * iPivot and hhmm(time[iPivot]) >= 800 and dayofmonth(time[iPivot], TZ) == dayofmonth(time, TZ)
    ph = high[iPivot]
    pl = low[iPivot]
    isH = true
    isL = true
    for k = 0 to 2 * iPivot
        if k != iPivot
            // offsets < iPivot are the newer bars (right side): must be strictly lower/higher;
            // older bars (left side) may be equal
            if k < iPivot ? high[k] >= ph : high[k] > ph
                isH := false
            if k < iPivot ? low[k] <= pl : low[k] < pl
                isL := false
    if isH
        addLevel(ph, 1, "Swing H", bar_index - iPivot)
    if isL
        addLevel(pl, -1, "Swing L", bar_index - iPivot)

// ───────── Sweep detection: every level traded through is used up ─────────
float sweptHiPx = na
string sweptHiName = na
float sweptLoPx = na
string sweptLoName = na
if array.size(lvPx) > 0
    for k = array.size(lvPx) - 1 to 0
        px = array.get(lvPx, k)
        sd = array.get(lvSide, k)
        if sd > 0 and high > px + tick
            if na(sweptHiPx) or px > sweptHiPx
                sweptHiPx := px
                sweptHiName := array.get(lvName, k)
            removeLevel(k, true)
        else if sd < 0 and low < px - tick
            if na(sweptLoPx) or px < sweptLoPx
                sweptLoPx := px
                sweptLoName := array.get(lvName, k)
            removeLevel(k, true)

// ───────── Day bookkeeping ─────────
var int tradesToday = 0
var int lossesToday = 0
var float npAtEntry = na
newDay = crossed(930)
if newDay
    tradesToday := 0
    lossesToday := 0

justClosed = strategy.closedtrades > strategy.closedtrades[1] and strategy.position_size == 0
if justClosed
    tradesToday += 1
    if strategy.netprofit < npAtEntry
        lossesToday += 1

// ───────── Trade state ─────────
var int   armSide = 0
var float armExt = na
var float armStruct = na
var float armPx = na
var int   armBar = na
var string armName = ""
var float tEntry = na
var float tStop = na
var float tTp1 = na
var float tTp2 = na
var int   pendBar = na
var bool  tp1Done = false
var float slOrig = na
var box   tbRisk = na
var box   tbRew = na
var line  tbTp1 = na

flat    = strategy.position_size == 0
pending = not na(pendBar)
inWindow = tod >= iStart and tod <= iLastEntry and tradesToday < iMaxTrades and lossesToday < iMaxLosses

placeExits() =>
    strategy.exit("TP1", "Sweep", qty_percent = iTp1Pct, limit = tTp1, stop = tStop, comment_profit = "TP1", comment_loss = "SL")
    strategy.exit("TP2", "Sweep", limit = tTp2, stop = tStop, comment_profit = "TP2", comment_loss = "SL")

// structure before the sweep (computed every bar so the ta.* history stays consistent)
lowestN  = ta.lowest(low, math.max(iStructLb, 1))
highestN = ta.highest(high, math.max(iStructLb, 1))
structLo = iStructLb > 0 ? lowestN[1] : low
structHi = iStructLb > 0 ? highestN[1] : high

// flat at session end
if tod >= iFlat and (not flat or pending)
    strategy.close_all(comment = "Time")
    if pending
        strategy.cancel("Sweep")
        pendBar := na
        npAtEntry := na

// pending limit order housekeeping
if pending and flat and not justClosed
    ranAway = tTp1 < tEntry ? low <= tTp1 : high >= tTp1
    if bar_index - pendBar >= iPendBars or ranAway
        strategy.cancel("Sweep")
        pendBar := na
        npAtEntry := na

// position just opened
if not flat and strategy.position_size[1] == 0
    pendBar := na
    tp1Done := false

// after TP1: move the remaining stop to breakeven
if not flat and not tp1Done and math.abs(strategy.position_size) < math.abs(strategy.position_size[1])
    tp1Done := true
    if iBe
        tStop := strategy.position_avg_price
        strategy.exit("TP2", "Sweep", limit = tTp2, stop = tStop, comment_profit = "TP2", comment_loss = "BE")

// ───────── Trade boxes (like the long/short position tool) ─────────
drawTrade(int eb, float ep) =>
    b1 = box.new(eb, math.max(ep, slOrig), bar_index, math.min(ep, slOrig),
         border_color = color.new(color.red, 50), bgcolor = color.new(color.red, 82))
    b2 = box.new(eb, math.max(ep, tTp2), bar_index, math.min(ep, tTp2),
         border_color = color.new(color.green, 50), bgcolor = color.new(color.green, 82))
    l1 = line.new(eb, tTp1, bar_index, tTp1, color = color.new(color.green, 20), style = line.style_dashed)
    [b1, b2, l1]

if iShowBoxes
    if not flat and strategy.position_size[1] == 0
        [b1, b2, l1] = drawTrade(strategy.opentrades.entry_bar_index(0), strategy.opentrades.entry_price(0))
        tbRisk := b1
        tbRew := b2
        tbTp1 := l1
    if justClosed and na(tbRisk)    // opened and closed within the same bar
        n = strategy.closedtrades - 1
        [b1, b2, l1] = drawTrade(strategy.closedtrades.entry_bar_index(n), strategy.closedtrades.entry_price(n))
        tbRisk := b1
        tbRew := b2
        tbTp1 := l1
    if not na(tbRisk)
        box.set_right(tbRisk, bar_index)
        box.set_right(tbRew, bar_index)
        line.set_x2(tbTp1, bar_index)
    if justClosed and not na(tbRisk)
        pnl = strategy.netprofit - npAtEntry
        label.new(bar_index, pnl >= 0 ? high : low, (pnl >= 0 ? "+" : "") + str.tostring(pnl, "#") + " $",
             yloc = pnl >= 0 ? yloc.abovebar : yloc.belowbar, color = color(na), size = size.small,
             textcolor = pnl >= 0 ? color.green : color.red,
             style = pnl >= 0 ? label.style_label_down : label.style_label_up)
        tbRisk := na
        tbRew := na
        tbTp1 := na

if justClosed
    npAtEntry := na

// arming and confirmation only when flat, no order working, inside the window
bool enteredNow = false
var int dbgSweeps = 0
var int dbgOrb = 0
var int dbgOrders = 0
canSetup = flat and not pending and not justClosed and inWindow
if not canSetup
    armSide := 0
else
    int newSide = 0
    if not na(sweptHiPx) and (not iCloseBack or close < sweptHiPx)
        newSide := -1
        armExt := high
        armPx := sweptHiPx
        armName := sweptHiName
        armStruct := structLo
    if not na(sweptLoPx) and (not iCloseBack or close > sweptLoPx)
        newSide := 1
        armExt := low
        armPx := sweptLoPx
        armName := sweptLoName
        armStruct := structHi
    if newSide != 0
        armSide := newSide
        armBar := bar_index
        dbgSweeps += 1
        alert("MNQ sweep of " + armName + (newSide < 0 ? " (short setup)" : " (long setup)"), alert.freq_once_per_bar_close)

    if armSide != 0
        s = armSide
        armExt := s < 0 ? math.max(armExt, high) : math.min(armExt, low)
        if bar_index - armBar > iConfirm
            armSide := 0
        else
            back = s < 0 ? math.min(armStruct, armPx) : math.max(armStruct, armPx)
            shifted = s < 0 ? close < back : close > back
            hasFvg = not iNeedFvg
            if iNeedFvg and bar_index > armBar
                for off = 0 to bar_index - armBar - 1
                    if s < 0 ? high[off] < low[off + 2] : low[off] > high[off + 2]
                        hasFvg := true
            if shifted and hasFvg and trendOk(s)
                float sl = s < 0 ? armExt + 2 * tick : armExt - 2 * tick
                float entry = close
                if iEntryMode == "OTE limit"
                    float legEnd = s < 0 ? low : high
                    for off = 0 to bar_index - armBar
                        legEnd := s < 0 ? math.min(legEnd, low[off]) : math.max(legEnd, high[off])
                    entry := math.round_to_mintick(legEnd + (armExt - legEnd) * iOte)
                float risk = math.abs(sl - entry)
                if risk <= (iRiskAtr > 0 ? iRiskAtr * atr14 : iMaxRisk)
                    if risk < iMinRisk
                        sl := entry - s * iMinRisk
                        risk := iMinRisk
                    tEntry := entry
                    tStop := sl
                    slOrig := sl
                    tTp1 := entry + s * iTp1R * risk
                    tTp2 := entry + s * iTp2R * risk
                    if iEntryMode == "Market"
                        strategy.entry("Sweep", s > 0 ? strategy.long : strategy.short, comment = armName)
                    else
                        strategy.entry("Sweep", s > 0 ? strategy.long : strategy.short, limit = entry, comment = armName)
                        pendBar := bar_index
                    npAtEntry := strategy.netprofit
                    enteredNow := true
                    dbgOrders += 1
                    placeExits()
                    alert("MNQ " + (s > 0 ? "LONG" : "SHORT") + " entry " + str.tostring(entry) + " SL " + str.tostring(sl) +
                         " TP1 " + str.tostring(tTp1) + " TP2 " + str.tostring(tTp2), alert.freq_once_per_bar_close)
                armSide := 0

// ───────── Opening range breakout ─────────
var float orHi = na
var float orLo = na
var bool  orbDone = false
todMin = hour(time, TZ) * 60 + minute(time, TZ)
orEnd  = 9 * 60 + 30 + iOrbMin
if newDay
    orHi := na
    orLo := na
    orbDone := false
if todMin >= 570 and todMin < orEnd
    orHi := na(orHi) ? high : math.max(orHi, high)
    orLo := na(orLo) ? low  : math.min(orLo, low)
else if iUseOrb and not orbDone and not na(orHi) and todMin >= orEnd and tod <= iLastEntry
    int so = close > orHi ? 1 : close < orLo ? -1 : 0
    if so != 0
        orbDone := true   // the first breakout decides the day
        dbgOrb += 1
        freeNow = strategy.position_size == 0 and na(pendBar) and not enteredNow and not justClosed and inWindow
        if freeNow and trendOk(so)
            float slO = (orHi + orLo) / 2 - so * 2 * tick
            float riskO = math.abs(close - slO)
            if riskO > 0 and riskO <= iMaxRisk
                tEntry := close
                tStop := slO
                slOrig := slO
                tTp1 := close + so * iTp1R * riskO
                tTp2 := close + so * iTp2R * riskO
                strategy.entry("Sweep", so > 0 ? strategy.long : strategy.short, comment = "ORB")
                dbgOrders += 1
                npAtEntry := strategy.netprofit
                placeExits()
                alert("MNQ ORB " + (so > 0 ? "LONG" : "SHORT") + " entry " + str.tostring(close) + " SL " + str.tostring(slO) +
                     " TP1 " + str.tostring(tTp1) + " TP2 " + str.tostring(tTp2), alert.freq_once_per_bar_close)

// ───────── M15 support / resistance zones (display only, not used for entries) ─────────
// Zone = wick area of a confirmed M15 swing: resistance from the candle body top to the high,
// support from the low to the body bottom. Drawn from the swing candle until a M5 close breaks
// through it (then the zone ends there) - a broken resistance is no longer shown as valid.
[z15H, z15HBot, z15L, z15LTop, z15T] = request.security(syminfo.tickerid, "15",
     [ta.pivothigh(high, iZ15Pivot, iZ15Pivot)[1], math.max(open, close)[iZ15Pivot + 1],
      ta.pivotlow(low, iZ15Pivot, iZ15Pivot)[1], math.min(open, close)[iZ15Pivot + 1], time[iZ15Pivot + 1]],
     lookahead = barmerge.lookahead_on)

var box[]   zBox  = array.new_box()
var float[] zTop  = array.new_float()
var float[] zBot  = array.new_float()
var int[]   zSide = array.new_int()
var int     zLastT = na

endZone(int k, bool broken) =>
    b = array.get(zBox, k)
    box.set_extend(b, extend.none)
    box.set_right(b, time)
    if not broken
        box.set_border_style(b, line.style_dotted)
    array.remove(zBox, k)
    array.remove(zTop, k)
    array.remove(zBot, k)
    array.remove(zSide, k)

newZone(float top, float bot, int side) =>
    col = side > 0 ? color.red : color.teal
    array.push(zBox, box.new(z15T, top, time, bot, xloc = xloc.bar_time, extend = extend.right,
         border_color = color.new(col, 60), bgcolor = color.new(col, 88)))
    array.push(zTop, top)
    array.push(zBot, bot)
    array.push(zSide, side)
    if array.size(zBox) > iZ15Max
        endZone(0, false)

if iShowZ15
    // invalidate: close above a resistance / below a support
    if array.size(zBox) > 0
        for k = array.size(zBox) - 1 to 0
            sd = array.get(zSide, k)
            if sd > 0 ? close > array.get(zTop, k) : close < array.get(zBot, k)
                endZone(k, true)
    if not na(z15T) and z15T != zLastT
        zLastT := z15T
        if not na(z15H) and close < z15H
            newZone(z15H, math.min(z15HBot, z15H - tick), 1)
        if not na(z15L) and close > z15L
            newZone(math.max(z15LTop, z15L + tick), z15L, -1)

// ───────── Visuals ─────────
showTrade = not flat or pending
plot(showTrade ? tStop : na, "Stop", color.red,   2, plot.style_linebr)
plot(showTrade ? tTp1  : na, "TP1",  color.lime,  1, plot.style_linebr)
plot(showTrade ? tTp2  : na, "TP2",  color.green, 2, plot.style_linebr)
plot(showTrade ? tEntry : na, "Entry", color.gray, 1, plot.style_linebr)
plot(iTrend == "EMA 20/50" ? ema20 : na, "EMA 20", color.new(color.orange, 20))
plot(iTrend == "EMA 20/50" ? ema50 : na, "EMA 50", color.new(color.purple, 20))
plot(iTrend == "Price vs VWAP" and tod >= 930 and tod < 1600 ? vwapV : na, "VWAP", color.new(color.blue, 20), style = plot.style_linebr)
bgcolor(tod >= iStart and tod <= iLastEntry ? color.new(color.blue, 94) : na, title = "Entry window")

// ───────── Debug: are signals firing and orders being sent? ─────────
iShowDbg = input.bool(true, "Show debug table", group = grpV)
var table dbg = table.new(position.top_right, 2, 5, bgcolor = color.new(color.gray, 85), border_width = 1)
if iShowDbg and barstate.islast
    table.cell(dbg, 0, 0, "Sweeps detected", text_size = size.small)
    table.cell(dbg, 1, 0, str.tostring(dbgSweeps), text_size = size.small)
    table.cell(dbg, 0, 1, "ORB breakouts", text_size = size.small)
    table.cell(dbg, 1, 1, str.tostring(dbgOrb), text_size = size.small)
    table.cell(dbg, 0, 2, "Orders sent", text_size = size.small)
    table.cell(dbg, 1, 2, str.tostring(dbgOrders), text_size = size.small)
    table.cell(dbg, 0, 3, "Trades filled", text_size = size.small)
    table.cell(dbg, 1, 3, str.tostring(strategy.closedtrades + strategy.opentrades), text_size = size.small)
    table.cell(dbg, 0, 4, "Chart TF / tick", text_size = size.small)
    table.cell(dbg, 1, 4, timeframe.period + " / " + str.tostring(syminfo.mintick), text_size = size.small)
